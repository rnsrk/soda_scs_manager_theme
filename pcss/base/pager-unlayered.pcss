/*
 * Pagination: Claro ships white pills + blue active state (unlayered pager.css).
 * Override for SODa dark stone canvas and orange accent (tabs, buttons, links).
 */
.page-wrapper nav.pager {
  --scs-manager--pager-size: 2.75rem;
  --scs-manager--pager-gap: 0.375rem;
  margin-block: 1.5rem;
}

.page-wrapper nav.pager .pager__items {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: var(--scs-manager--pager-gap);
  margin: 0;
  padding: 0;
  list-style: none;
  font-weight: 500;
}

.page-wrapper nav.pager .pager__item {
  display: inline-flex;
  margin: 0;
  vertical-align: top;
}

.page-wrapper nav.pager .pager__link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-inline-size: var(--scs-manager--pager-size);
  min-block-size: var(--scs-manager--pager-size);
  padding-inline: 0.75rem;
  border: 1px solid rgb(68 64 60);
  border-radius: 0.5rem;
  background-color: rgb(41 37 36);
  color: rgb(231 229 228) !important;
  font-size: 0.875rem;
  font-weight: 500;
  line-height: 1;
  text-decoration: none !important;
  transition:
    background-color 0.15s ease-in-out,
    border-color 0.15s ease-in-out,
    color 0.15s ease-in-out;
}

.page-wrapper nav.pager .pager__link:hover,
.page-wrapper nav.pager .pager__link:focus {
  text-decoration: none !important;
}

.page-wrapper nav.pager .pager__link:hover:not(.is-active) {
  background-color: rgb(68 64 60);
  border-color: rgb(87 83 78);
  color: #e68500 !important;
}

.page-wrapper nav.pager .pager__link.is-active,
.page-wrapper nav.pager .pager__item--current {
  border-color: transparent;
  background: linear-gradient(160deg, rgb(255, 138, 5) 0%, rgb(198, 105, 0) 78.66%);
  color: #fff !important;
  font-weight: 600;
}

.page-wrapper nav.pager .pager__link.is-active:hover {
  background: rgb(198, 105, 0);
  color: #fff !important;
}

.page-wrapper nav.pager .pager__link:focus-visible {
  outline: 2px solid #e68500;
  outline-offset: 2px;
  box-shadow: 0 0 0 4px rgba(230, 133, 0, 0.28);
}

.page-wrapper nav.pager .pager__link--action-link {
  border-radius: 0.5rem;
  padding-inline: 1rem;
  gap: 0.5rem;
}

.page-wrapper nav.pager .pager__item-title--backwards {
  margin-inline-start: 0.5rem;
}

.page-wrapper nav.pager .pager__item-title--forward {
  margin-inline-end: 0.5rem;
}

.page-wrapper nav.pager .pager__item--ellipsis {
  display: inline-flex;
  align-items: center;
  min-block-size: var(--scs-manager--pager-size);
  padding-inline: 0.25rem;
  color: rgb(168 162 158);
  font-weight: 500;
}

/* Recolor Claro SVG chevrons via mask + currentColor (dark icons are invisible on stone-800). */
.page-wrapper nav.pager .pager__item--first .pager__link::before {
  --scs-manager--pager-icon: url(/core/themes/claro/images/icons/545560/pager-first.svg);
}

.page-wrapper nav.pager .pager__item--previous .pager__link::before {
  --scs-manager--pager-icon: url(/core/themes/claro/images/icons/545560/pager-prev.svg);
}

.page-wrapper nav.pager .pager__item--next .pager__link::after {
  --scs-manager--pager-icon: url(/core/themes/claro/images/icons/545560/pager-next.svg);
}

.page-wrapper nav.pager .pager__item--last .pager__link::after {
  --scs-manager--pager-icon: url(/core/themes/claro/images/icons/545560/pager-last.svg);
}

.page-wrapper nav.pager .pager__item--first .pager__link::before,
.page-wrapper nav.pager .pager__item--previous .pager__link::before,
.page-wrapper nav.pager .pager__item--next .pager__link::after,
.page-wrapper nav.pager .pager__item--last .pager__link::after {
  position: relative;
  display: inline-block;
  inline-size: 1rem;
  block-size: 1rem;
  content: "";
  background-color: currentColor;
  background-image: none;
  -webkit-mask-image: var(--scs-manager--pager-icon);
  mask-image: var(--scs-manager--pager-icon);
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
  -webkit-mask-size: contain;
  mask-size: contain;
}

[dir="rtl"] .page-wrapper nav.pager .pager__item--first .pager__link::before,
[dir="rtl"] .page-wrapper nav.pager .pager__item--previous .pager__link::before,
[dir="rtl"] .page-wrapper nav.pager .pager__item--next .pager__link::after,
[dir="rtl"] .page-wrapper nav.pager .pager__item--last .pager__link::after {
  transform: scaleX(-1);
}

@media (prefers-reduced-motion: reduce) {
  .page-wrapper nav.pager .pager__link {
    transition: none;
  }
}
