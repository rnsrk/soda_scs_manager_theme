/*
 * Unlayered: sidebar book nav (custom_book_block) must beat Claro link colors.
 * Matches .scs-manager--nav-menu-bar orange; .is-active-page from bookActivePage.js.
 */
.scs-manager--sidebar .block-custom-book-navigation a {
  color: #e68500;
  text-decoration: none;
}

.scs-manager--sidebar .block-custom-book-navigation a:hover {
  color: #b86a00;
}

.scs-manager--sidebar .block-custom-book-navigation a.is-active-page {
  color: #171717;
  font-weight: 600;
}
