/*
 * Body / text-formatted links in the primary column: match SODa orange (nav-unlayered).
 * Claro’s a:hover removes underline — keep underline here. Skip .button (link styled as button)
 * and admin dashboard cards (whole card is the control; underline looks like body copy).
 * Skip .soda-scs-manager--card-icon (circular info/book controls: own border + bg).
 * Skip .soda-scs-manager--add-app-popup-card (whole-card links in add-application modal).
 * Skip .soda-scs-manager--add-app-heading-button (circular (+) beside headings; own border styling).
 * Skip .health-badge (status chip; green/amber pill + optional login link, not body copy).
 * Skip .pager__link (pagination controls; styled in pager-unlayered.pcss).
 */
.scs-manager--content-main a:not(.button):not(.pager__link):not(.soda-scs-manager--admin-card-link):not(.soda-scs-manager--card-icon):not(.soda-scs-manager--add-app-heading-button):not(.soda-scs-manager--add-app-popup-card):not(.health-badge):not(.scs-manager--home-hero-cta) {
  color: #e68500;
  text-decoration: underline;
  text-underline-offset: 0.125em;
}

.scs-manager--content-main a:not(.button):not(.pager__link):not(.soda-scs-manager--admin-card-link):not(.soda-scs-manager--card-icon):not(.soda-scs-manager--add-app-heading-button):not(.soda-scs-manager--add-app-popup-card):not(.health-badge):not(.scs-manager--home-hero-cta):hover,
.scs-manager--content-main a:not(.button):not(.pager__link):not(.soda-scs-manager--admin-card-link):not(.soda-scs-manager--card-icon):not(.soda-scs-manager--add-app-heading-button):not(.soda-scs-manager--add-app-popup-card):not(.health-badge):not(.scs-manager--home-hero-cta):focus {
  color: #b86a00;
  text-decoration: underline;
  text-underline-offset: 0.125em;
}

.scs-manager--content-main a:not(.button):not(.pager__link):not(.soda-scs-manager--admin-card-link):not(.soda-scs-manager--card-icon):not(.soda-scs-manager--add-app-heading-button):not(.soda-scs-manager--add-app-popup-card):not(.health-badge):not(.scs-manager--home-hero-cta):active {
  color: #9a5800;
  text-decoration: underline;
  text-underline-offset: 0.125em;
}

/*
 * Home CTA: unlayered so Claro / .text-formatted link colors do not win over @layer components.
 */
.scs-manager--content-main a.scs-manager--home-hero-cta,
.text-formatted a.scs-manager--home-hero-cta,
a.scs-manager--home-hero-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: fit-content;
  min-height: 2.75rem;
  padding: 0.75rem 2rem;
  border: none;
  border-radius: 0.75rem;
  background-color: #3939ac !important;
  color: #fff !important;
  font-family: "metropolis", sans-serif;
  font-size: 1rem;
  font-weight: 500;
  line-height: 1.25;
  text-decoration: none !important;
  text-underline-offset: 0;
  cursor: pointer;
  transition: background-color 0.15s ease-in-out;
}

.scs-manager--content-main a.scs-manager--home-hero-cta:hover,
.scs-manager--content-main a.scs-manager--home-hero-cta:focus,
.scs-manager--content-main a.scs-manager--home-hero-cta:focus-visible,
.scs-manager--content-main a.scs-manager--home-hero-cta:visited,
.text-formatted a.scs-manager--home-hero-cta:hover,
.text-formatted a.scs-manager--home-hero-cta:focus,
.text-formatted a.scs-manager--home-hero-cta:focus-visible,
.text-formatted a.scs-manager--home-hero-cta:visited,
a.scs-manager--home-hero-cta:hover,
a.scs-manager--home-hero-cta:focus,
a.scs-manager--home-hero-cta:focus-visible,
a.scs-manager--home-hero-cta:visited {
  background-color: #2f2f91 !important;
  color: #fff !important;
  text-decoration: none !important;
}

.scs-manager--content-main a.scs-manager--home-hero-cta:focus-visible,
.text-formatted a.scs-manager--home-hero-cta:focus-visible,
a.scs-manager--home-hero-cta:focus-visible {
  outline: 2px solid #3939ac;
  outline-offset: 2px;
}
