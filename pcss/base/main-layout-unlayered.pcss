/*
 * Sticky footer: on short pages keep the dark footer bar at the viewport bottom.
 * DOM: body > .page-wrapper > main > … > .scs-manager--main-layout-container + footer.
 * The main column grows so header/nav stay at the top and the footer sits at the bottom.
 */
body {
  display: flex;
  flex-direction: column;
  min-height: 100dvh;
}

.page-wrapper {
  display: flex;
  flex: 1 0 auto;
  flex-direction: column;
}

.page-wrapper > main {
  display: flex;
  flex: 1 0 auto;
  flex-direction: column;
}

.layout-container.scs-manager--main-layout-container {
  flex: 1 0 auto;
}

/*
 * Center the primary page column.
 * Claro system-admin--layout.css sets horizontal margins on `.layout-container` using
 * selectors such as `.toolbar-tray-open:not(.toolbar-vertical) .layout-container`
 * (specificity 0,3,0), which beats `.layout-container.scs-manager--main-layout-container`
 * (0,2,0). !important keeps auto margins winning for horizontal and vertical toolbar.
 */
.layout-container.scs-manager--main-layout-container {
  box-sizing: border-box;
  width: 100%;
  max-width: min(70%, 1400px);
  margin-left: auto !important;
  margin-right: auto !important;
}

/*
 * Page title in content_above: Claro’s unlayered `.page-title { font-size: var(--font-size-h1) }`
 * beats `@layer components`, so large type must be unlayered too.
 * Block margins/padding: Claro’s unlayered `.block-page-title-block` uses margin-block-end; override here
 * so `@layer components` utilities are not overridden by Claro.
 */
.layout-container.scs-manager--main-layout-container .region-content-above .block-page-title-block {
  margin-block-end: 0;
  padding-top: 0;
  padding-bottom: 0;
}

/*
 * Target any h1 in the page-title block (not only h1.page-title): some stacks omit
 * the class on output, which would otherwise drop this typography to base h1 size.
 */
.layout-container.scs-manager--main-layout-container .region-content-above .block-page-title-block h1 {
  margin: 0;
  /*
   * Fluid type: scales with viewport between a compact mobile minimum and the
   * previous desktop cap (4.5rem), replacing stepped breakpoints.
   */
  font-size: clamp(1.625rem, 0.85rem + 4.8vw, 4.5rem);
  font-weight: 700;
  line-height: 1.12;
  letter-spacing: -0.025em;
  color: rgb(0 0 0 / 1);
  overflow-wrap: anywhere;
}

@media (width >= 48rem) {
  .layout-container.scs-manager--main-layout-container .region-content-above .block-page-title-block h1 {
    line-height: 1.15;
  }
}
