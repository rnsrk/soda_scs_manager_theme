/* Base fonts */
/* These styles define the base font configurations. */
/* Inter @font-face rules live in css/inter.css (bundled woff2 under fonts/inter/), attached first
   from soda_scs_manager_theme.libraries.yml so faces load before Tailwind utilities. */

@layer base {
  html, body {
    font-family: 'Inter', sans-serif;
  }
}

/* CSS custom properties for font families. */
:root {
  --font-sans: 'Inter', sans-serif;
  --default-font-family: var(--font-sans);
}

