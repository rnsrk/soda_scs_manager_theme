/*
 * Unlayered so these win over scs_custom_theme `button` (display:flex, dark fill,
 * fit-content, rem padding). That rule sits outside @layer and beats the intro
 * wizard's @layer components. Root font-size is a few pixels, so rem padding
 * and a 12rem max-width collapsed Skip onto the panel edge and clipped it.
 */

#scs-manager--coworking-intro .scs-manager--coworking-intro-header {
  padding: 16px 16px 8px;
}

#scs-manager--coworking-intro .scs-manager--coworking-intro-footer {
  padding: 12px 16px;
  gap: 8px;
}

#scs-manager--coworking-intro .scs-manager--coworking-intro-footer-control--hidden {
  display: none;
}

#scs-manager--coworking-intro .scs-manager--coworking-intro-skip-row {
  display: flex;
  justify-content: flex-end;
  width: 100%;
  min-width: 0;
  max-width: 100%;
}

#scs-manager--coworking-intro .scs-manager--coworking-intro-skip {
  display: inline-block;
  flex: 0 0 auto;
  width: max-content;
  min-width: 0;
  max-width: 100%;
  height: auto;
  min-height: 32px;
  margin: 0;
  padding: 6px 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  color: #78716c;
  font-size: clamp(12px, 2.6rem, 14px);
  font-weight: 500;
  line-height: 1.3;
  text-align: end;
  text-decoration: underline;
  white-space: normal;
  overflow-wrap: anywhere;
  gap: 0;
}

#scs-manager--coworking-intro .scs-manager--coworking-intro-skip:hover {
  background: transparent;
  color: #17212b;
}
