{
  "private": true,
  "name": "soda_scs_manager_theme",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx @tailwindcss/cli --input pcss/soda_scs_manager_theme.pcss --output css/style.css --watch",
    "build": "NODE_ENV=production postcss pcss/soda_scs_manager_theme.pcss -o css/style.css --map --config postcss.config.js",
    "build:dev": "postcss pcss/soda_scs_manager_theme.pcss -o css/style.css --map --config postcss.config.js",
    "watch": "postcss pcss/soda_scs_manager_theme.pcss -o css/style.css --map --watch --config postcss.config.js",
    "clean": "rm -rf css/style.css*"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/postcss": "^4.3.1",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "baseline-browser-mapping": "^2.10.38",
    "cssnano": "^8.0.2",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1"
  },
  "overrides": {
    "picomatch": ">=4.0.4"
  }
}
