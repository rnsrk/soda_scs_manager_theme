@layer components {
  a {
    &.soda-scs-manager--tile-card {
      @apply box-border rounded-none p-6 flex flex-col items-center text-center border-0 bg-transparent;
      @apply no-underline transition-colors duration-200;
      &::after {
        content: '';
        position: absolute;
        inset: 0;
        box-sizing: border-box;
        border: 2px solid #000;
        border-top-color: #000;
        border-right-color: #000;
        border-bottom-color: #000;
        border-left-color: #000;
        border-radius: 0;
        background: transparent;
        pointer-events: none;
        z-index: 3;
        transition: border-color 0.2s ease-in-out;
      }
      &:hover::after {
        border-color: #e68500;
      }
      h2 {
        @apply relative z-[2] bg-white text-xl font-semibold text-[#e68500] underline underline-offset-2 mt-4 mb-2;
      }
      p {
        @apply relative z-[2] bg-white text-stone-900;
      }
    }
  }
  .soda-scs-manager--card-type {
    @apply w-full shrink-0 text-center;
  }
  .soda-scs-manager--type--card {
    @apply relative box-border flex h-full min-h-0 w-full flex-col items-stretch p-3 text-center sm:p-4 xl:p-4;
  }
  .soda-scs-manager--health-icon {
    @apply absolute top-2 left-2 w-8 h-8 rounded-full border border-stone-300 transition-all duration-200 ease-in-out;
    @apply bg-white;
    @apply shadow-sm;
    z-index: 55;
    &::before {
      content: '';
      @apply absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      transform: translate(-50%, -50%);
      width: 20px;
      height: 20px;
      background-size: contain;
      background-position: center;
      background-repeat: no-repeat;
    }
    &.soda-scs-manager--health-running::before {
      background-image: url('/modules/custom/soda_scs_manager/assets/images/health-running.svg');
    }
    &.soda-scs-manager--health-starting::before {
      background-image: url('/modules/custom/soda_scs_manager/assets/images/health-starting.svg');
      animation: pulse 1.5s ease-in-out infinite;
    }
    &.soda-scs-manager--health-stopped::before {
      background-image: url('/modules/custom/soda_scs_manager/assets/images/health-stopped.svg');
    }
    &.soda-scs-manager--health-failure::before {
      background-image: url('/modules/custom/soda_scs_manager/assets/images/health-failure.svg');
    }
    &.soda-scs-manager--health-unknown::before {
      background-image: url('/modules/custom/soda_scs_manager/assets/images/health-starting.svg');
      animation: pulse 1.5s ease-in-out infinite;
    }
  }
  @keyframes pulse {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.4;
    }
  }
  a.soda-scs-manager--card-icon {
    @apply no-underline;
  }
  .soda-scs-manager--card-icon {
    @apply absolute top-2 w-8 h-8 rounded-full cursor-pointer;
    @apply bg-white;
    @apply border border-stone-300;
    @apply shadow-sm hover:shadow-md;
    @apply outline-none;
    z-index: 55;
    background-color: #fff !important;
    transition: background-color 0.2s ease-in-out, box-shadow 0.3s ease-in-out, border-color 0.4s ease-in-out, transform 0.2s ease-in-out;
    &:hover {
      @apply border-[#e68500];
      background-color: #fff;
    }
    &:focus-visible {
      @apply bg-white border-[#e68500];
      background-color: #fff;
    }
    &:active {
      @apply bg-white border-[#b86a00];
      background-color: #fff;
      transform: scale(0.92);
    }
    &::before {
      content: '';
      @apply absolute;
      top: 50%;
      left: 50%;
      z-index: 1;
      transform: translate(-50%, -50%);
      width: 20px;
      height: 20px;
      background-size: contain;
      background-position: center;
      background-repeat: no-repeat;
      transition: background-image 0.2s ease-in-out;
    }
  }
  .soda-scs-manager--details-icon {
    @apply right-12;
    &::before {
      background-color: #e68500;
      background-image: none;
      mask-image: url('/modules/custom/soda_scs_manager/assets/images/info-icon-mask.svg');
      mask-size: contain;
      mask-repeat: no-repeat;
      mask-position: center;
      -webkit-mask-image: url('/modules/custom/soda_scs_manager/assets/images/info-icon-mask.svg');
      -webkit-mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      -webkit-mask-position: center;
      transition: background-color 0.2s ease-in-out;
    }
    &:hover::before {
      background-color: #b86a00;
    }
    &:focus-visible::before, &:active::before {
      background-color: #b86a00;
    }
  }
  .soda-scs-manager--card-icon.soda-scs-manager--book-icon {
    @apply right-2;
    &::before {
      background-color: #e68500;
      background-image: none;
      mask-image: url('/modules/custom/soda_scs_manager/assets/images/book-icon-mask.svg');
      mask-size: contain;
      mask-repeat: no-repeat;
      mask-position: center;
      -webkit-mask-image: url('/modules/custom/soda_scs_manager/assets/images/book-icon-mask.svg');
      -webkit-mask-size: contain;
      -webkit-mask-repeat: no-repeat;
      -webkit-mask-position: center;
      transition: background-color 0.2s ease-in-out;
    }
    &:hover::before {
      background-color: #b86a00;
    }
    &:focus-visible::before, &:active::before {
      background-color: #b86a00;
    }
  }
  .soda-scs-manager--card-content-wrapper {
    @apply relative box-border flex min-h-0 w-full flex-1 flex-col items-stretch rounded-none border-0 bg-transparent p-3 text-center opacity-100 transition-all duration-300 ease-in-out overflow-visible sm:p-4 xl:p-4;
  }
  .soda-scs-manager--card-status-banner {
    pointer-events: none;
    @apply absolute left-1/2 top-1/2 z-[45] flex max-h-[min(22rem,calc(100%-2rem))] w-max min-w-0 flex-col items-stretch gap-2 overflow-y-auto text-center opacity-0 invisible;
    max-width: calc(100% - 1.25rem);
    transform: translate(-50%, -50%) scale(1);
  }
  .soda-scs-manager--card-content-wrapper.soda-scs-manager--card--not-running .soda-scs-manager--card-status-banner:not(:empty) {
    @apply visible rounded-sm border border-stone-200 bg-white px-3 py-3 opacity-100 shadow-md md:px-4 md:py-3.5;
  }
  .soda-scs-manager--card-status-banner__throbber {
    @apply mb-1 box-border flex-shrink-0 self-center rounded-full border-[3px] border-orange-300 border-t-orange-500;
    width: 2.25rem;
    height: 2.25rem;
    @apply animate-spin;
  }
  @media (prefers-reduced-motion: reduce) {
    .soda-scs-manager--card-status-banner__throbber {
      animation: none;
      opacity: 0.85;
    }
  }
  .soda-scs-manager--card-status-banner__primary {
    @apply max-w-full text-sm font-semibold leading-snug text-stone-900 md:text-base;
  }
  .soda-scs-manager--card-status-banner__secondary {
    @apply max-w-full text-xs font-normal leading-snug text-stone-800 md:text-sm;
  }
  .soda-scs-manager--card-status-banner__detail {
    @apply block font-medium text-stone-900;
  }
  .soda-scs-manager--card-status-banner a.soda-scs-manager--card-status-banner__mailto {
    pointer-events: auto;
    @apply font-medium text-[#b86a00] underline decoration-[#b86a00]/80 underline-offset-2 transition-colors;
  }
  .soda-scs-manager--card-status-banner a.soda-scs-manager--card-status-banner__mailto:hover {
    @apply text-[#8c5200] decoration-[#8c5200];
  }
  .soda-scs-manager--card-content-wrapper::after {
    content: '';
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    border: 2px solid #000;
    border-top-color: #000;
    border-right-color: #000;
    border-bottom-color: #000;
    border-left-color: #000;
    border-radius: 0;
    background: transparent;
    pointer-events: none;
    z-index: 3;
    @apply transition-all duration-300 ease-in-out;
  }
  .soda-scs-manager--card-content-wrapper:hover::after {
    border-color: #e68500;
  }
  .soda-scs-manager--card-content-wrapper.soda-scs-manager--card--not-running::after {
    background: rgba(120, 113, 108, 0.5);
    pointer-events: auto;
    z-index: 40;
  }
  .soda-scs-manager--card-content-wrapper.soda-scs-manager--card--not-running.soda-scs-manager--card--status-stopped::after {
    background: rgba(87, 83, 78, 0.55);
  }
  .soda-scs-manager--card-content-wrapper.soda-scs-manager--card--not-running.soda-scs-manager--card--status-offline::after {
    background: rgba(68, 64, 60, 0.62);
  }
  .soda-scs-manager--card-body {
    @apply relative z-[2] min-h-0 flex-1 overflow-y-auto bg-white;
  }
  .soda-scs-manager--image-wrapper {
    @apply relative z-[2] flex aspect-[4/3] w-full shrink-0 items-center justify-center overflow-hidden bg-white;
  }
  .soda-scs-manager--card-img-top {
    @apply block h-full w-full max-h-full max-w-full object-contain object-center;
  }
  .soda-scs-manager--tag-filter-container {
    @apply w-full;
  }
  .soda-scs-manager--dashboard-heading-filter {
    @apply m-1 my-1 p-1 text-center text-2xl font-bold text-black;
  }
  .soda-scs-manager--dashboard-heading-section {
    @apply mb-4 text-center text-3xl font-bold text-black;
  }
  .soda-scs-manager--dashboard-heading-with-add {
    @apply flex flex-wrap items-center justify-center gap-2 md:gap-3;
  }
  .soda-scs-manager--dashboard-heading-section--inline {
    @apply mb-0 text-center;
  }
  .soda-scs-manager--add-app-heading-button {
    @apply box-border inline-flex shrink-0 cursor-pointer items-center justify-center rounded-full border-2 border-stone-400 bg-transparent p-0 font-light text-stone-600;
    @apply h-10 w-10 md:h-11 md:w-11;
    @apply transition-all duration-200 ease-in-out;
    @apply hover:border-[#e68500] hover:text-[#e68500];
  }
  .soda-scs-manager--add-app-heading-button:active {
    transform: scale(0.92);
  }
  a.soda-scs-manager--add-app-heading-button {
    @apply no-underline;
  }
  a.soda-scs-manager--add-app-heading-button:any-link {
    @apply text-stone-600;
  }
  a.soda-scs-manager--add-app-heading-button:visited {
    @apply border-stone-400 text-stone-600;
  }
  a.soda-scs-manager--add-app-heading-button:hover, a.soda-scs-manager--add-app-heading-button:visited:hover {
    @apply border-[#e68500] text-[#e68500];
  }
  .soda-scs-manager--add-app-heading-plus {
    position: relative;
    top: -1px;
    font-size: 20px;
    line-height: 1;
  }
  #clear-all-tags {
    @apply shadow-sm hover:shadow-md transition-shadow;
  }
  .soda-scs-manager--tag-filter-button {
    @apply shadow-sm hover:shadow-md transition-shadow;
  }
  .soda-scs-manager--tag-filter-button[aria-pressed="true"] {
    @apply shadow-md font-semibold;
  }
  .soda-scs-manager--tag-filter-button[aria-pressed="true"] .soda-scs-manager--tag-remove {
    @apply inline-block;
  }
  .soda-scs-manager--tag-remove {
    @apply font-bold text-base ml-1;
  }
  .soda-scs-manager--type--card.hidden-by-filter {
    @apply opacity-0 max-h-0 my-0 py-0 border-0 pointer-events-none;
  }
  .soda-scs-manager--empty-filter-message {
    @apply col-span-full text-center py-8 px-4;
    p {
      @apply text-stone-300 text-lg;
    }
    a {
      @apply text-[#e68500] hover:text-[#b86a00] underline transition-colors duration-200;
    }
  }
  .soda-scs-manager--card-title {
    @apply text-base font-semibold text-[#e68500] xl:text-lg;
  }
  .soda-scs-manager--card-text {
    @apply text-sm text-stone-800 xl:text-base;
  }
  .soda-scs-manager--add-app-content {
    @apply border-dashed border-black hover:border-[#e68500];
    @apply cursor-pointer;
  }
  .soda-scs-manager--add-app-content .soda-scs-manager--add-app-button {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    @apply bg-transparent border-0 p-0 cursor-pointer z-10;
  }
  .soda-scs-manager--plus-icon-container {
    @apply transition-all duration-300;
  }
  .soda-scs-manager--plus-icon {
    @apply transition-all duration-300;
  }
  .soda-scs-manager--add-app-content:hover .soda-scs-manager--plus-icon {
    @apply text-[#e68500] scale-110;
  }
  .soda-scs-manager--add-app-popup {
    z-index: 9999;
    @apply transition-opacity duration-300;
  }
  .soda-scs-manager--add-app-popup.hidden {
    @apply opacity-0;
  }
  .soda-scs-manager--add-app-popup.flex {
    @apply opacity-100;
  }
  .soda-scs-manager--add-app-popup-inner {
    max-height: 90vh;
    @apply overflow-y-auto;
  }
  @media (max-width: 767px) {
    .soda-scs-manager--add-app-popup {
      @apply p-3;
    }
    .soda-scs-manager--add-app-popup-inner {
      @apply p-6 max-w-full;
    }
    .soda-scs-manager--add-app-popup h2 {
      @apply text-2xl mb-6;
    }
    .soda-scs-manager--add-app-popup .grid {
      @apply grid-cols-1 gap-4;
    }
  }
  #add-app-popup .soda-scs-manager--add-app-popup-card:focus:not(:focus-visible), #add-app-popup .soda-scs-manager--add-app-popup-card:active {
    outline: none;
    box-shadow: none;
  }
  #add-app-popup .soda-scs-manager--add-app-popup-card:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px #e68500, 0 0 0 4px rgba(230, 133, 0, 0.28);
  }
}
